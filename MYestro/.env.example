# Synthphony MYestro .env.example
# Copy to .env — secrets auto-generated by setup.sh
# Do NOT commit .env to Git. Keep chmod 600.

BASE_DOMAIN=synth.home.arpa

# ---- Nextcloud ----
# Auto-generated by setup.sh into secrets/
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
# Set a strong password before first start!
NEXTCLOUD_ADMIN_PASSWORD=change-me-strong-password

# ---- Solidtime ----
# Auto-generated by setup.sh
SOLIDTIME_DB_PASSWORD=
# Admin email for initial Solidtime user (set before first start)
SOLIDTIME_ADMIN_EMAIL=admin@example.com
