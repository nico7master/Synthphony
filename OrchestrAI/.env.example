# Synthphony-OrchestrAI/.env.example
BASE_DOMAIN=synth.home.arpa

# Windmill secrets (auto-generated by setup.sh into secrets/)
WINDMILL_DB_PASSWORD=
WM_ENCRYPTION_KEY=
WM_JWT_SECRET=

# AgentZero image (custom build)
AGENTZERO_IMAGE=ghcr.io/your-org/agentzero:v1.0.0

# Open Notebook secrets (auto-generated by setup.sh into secrets/)
OPENNOTEBOOK_ENCRYPTION_KEY=
SURREAL_PASSWORD=

# OmniRoute AI Gateway (auto-generated by setup.sh into secrets/)
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_INITIAL_PASSWORD=
# HDD Storage for Agent Zero (optional - defaults to /mnt/hdd/agentzero-storage)
HDD_STORAGE_PATH=/mnt/hdd/agentzero-storage
