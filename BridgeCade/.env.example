# Synthphony-BridgeCade/.env.example
# Copy to .env and fill with non-secret config; real secrets live in ./secrets/*.txt
# Do not commit .env or secrets/*.txt to Git.

# Required (non-secret)
BASE_DOMAIN=synth.home.arpa

# Autodetected by setup.sh (do not edit by hand)
BRIDGECADE_LAN_IP=
LAN_CIDR=
# LAN network address for Tailscale subnet routing (auto-calculated)
LAN_NETWORK=
# Tailscale route mode: "minimal" = just this server (/32), "full" = entire LAN (/24)
TAILSCALE_ROUTE_MODE=minimal
WG_SUBNET=
WG_SERVER_IP=
WG_ALLOWEDIPS=
WG_INTERNAL_SUBNET=

# WireGuard endpoint (set these to public DNS/IP and port)
# WG_SERVERURL is auto-detected as LAN IP by setup.sh
# For remote VPN access, change to your public IP or DDNS hostname
WG_SERVERURL=
WG_SERVERPORT=51821

# Peer names to generate (comma-separated)
WG_PEERS=laptop,phone

# Tailscale (optional - for VPN without port forwarding)
# Option 1: Leave empty for interactive login (easiest)
# Option 2: Get auth key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=
